# -----------------------------------------------------------------------------
# Legacy frontend configuration. Copy to .env.local and fill in.
# -----------------------------------------------------------------------------

# --- Network -----------------------------------------------------------------
# "monad" for mainnet; anything else (or unset) means Monad testnet.
NEXT_PUBLIC_CHAIN=monad-testnet
# Optional: override the public RPC (rate limited) with your own endpoint.
NEXT_PUBLIC_RPC_URL=

# --- Contracts ---------------------------------------------------------------
# Optional. The app ships with the canonical Monad testnet deployment built in
# (legacy-contract/deployments/monad-testnet.json). To use your own, paste the
# lines printed by `forge script script/DeployMonad.s.sol ... --broadcast`;
# they only take effect when NEXT_PUBLIC_CHAIN is set.
NEXT_PUBLIC_FACTORY_ADDRESS=
NEXT_PUBLIC_VERIFIER_ADDRESS=        # PasskeyVerifierAdapter
NEXT_PUBLIC_IMPLEMENTATION_ADDRESS=
NEXT_PUBLIC_POLICY_ENGINE_ADDRESS=
# Optional: a vault the claim page offers as "Try an example vault".
NEXT_PUBLIC_SMOKE_VAULT_ADDRESS=

# New vaults start with 2min / 30s / 60s timings on testnet (so a whole
# inheritance can be demoed in minutes) and 30d / 7d / 3d on mainnet.
# Set "true" or "false" to override. Owners can change timings later.
NEXT_PUBLIC_DEMO_TIMINGS=

# --- Wallets -----------------------------------------------------------------
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Sealed messages & notifications (server) --------------------------------
# MongoDB holds only ciphertext for sealed messages; keys never reach the server.
MONGODB_URI=
# Vercel Blob, for encrypted video messages.
BLOB_READ_WRITE_TOKEN=
# Protects the heartbeat cron that sends reminder emails (not part of the trust path).
CRON_SECRET=

# Email: either SMTP/Gmail...
EMAIL_USER=
EMAIL_PASS=
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_SERVICE=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
EMAIL_FROM=
# ...or Resend.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Optional Push Protocol notifications.
PUSH_CHANNEL_ADDRESS=
PUSH_CHANNEL_PRIVATE_KEY=
NEXT_PUBLIC_CHAIN_ID=

# --- AI will compiler (optional) ---------------------------------------------
# Without a key, the policy engine uses its built-in deterministic compiler.
GEMINI_API_KEY=
OPENAI_API_KEY=
