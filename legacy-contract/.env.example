# -----------------------------------------------------------------------------
# Legacy Protocol deployment configuration (DO NOT COMMIT THE ACTUAL .env FILE)
# -----------------------------------------------------------------------------

# Deployer key. The default below is Anvil account #0, for local testing only.
# For Monad testnet, fund the deployer from https://faucet.monad.xyz
PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# Monad RPCs are configured in foundry.toml as `monad` and `monad_testnet`.
#   forge script script/DeployMonad.s.sol --rpc-url monad_testnet --broadcast

# Optional: contract verification on Monadscan (Etherscan v2 API key).
#   ... --verify
ETHERSCAN_API_KEY=

# -----------------------------------------------------------------------------
# Legacy World ID deployment (DeployLegacy.s.sol, World Chain Sepolia)
# -----------------------------------------------------------------------------
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
WORLDCHAIN_SEPOLIA_RPC_URL=https://worldchain-sepolia.g.alchemy.com/public
WORLD_ID_ROUTER=0x57f928158C3EE7CDad1e4D8642503c4D0201f611
WORLD_ID_GROUP_ID=1
WORLD_ID_APP_ID=app_staging_legacy_vault
WORLD_ID_ACTION=heartbeat
WORLDSCAN_API_KEY=
